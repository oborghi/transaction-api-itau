{
  "info": {
    "name": "Transaction API",
    "_postman_id": "transaction-api-collection",
    "description": "API de Autorização de Transações Financeiras - Desafio Técnico",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Generate Token (Valid Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200 && jsonData.token) {",
                  "    pm.environment.set('TOKEN', jsonData.token);",
                  "    pm.environment.set('TOKEN_EXPIRES_IN', jsonData.expires_in);",
                  "    pm.environment.set('TOKEN_EXPIRES_AT', jsonData.expires_at);",
                  "    console.log('✅ Token saved to environment: ' + jsonData.token.substring(0, 20) + '...');",
                  "} else {",
                  "    console.log('❌ Failed to get token: ' + pm.response.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{CLIENT_ID}}\",\n  \"client_secret\": \"{{CLIENT_SECRET}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/token",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        },
        {
          "name": "Generate Token (Invalid Credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"wrong\",\n  \"client_secret\": \"wrong\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/token",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "CREDIT Transaction (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Transaction succeeded', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.transaction.status).to.eql('SUCCEEDED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{ACCOUNT_ID}}\",\n  \"type\": \"CREDIT\",\n  \"amount\": {\n    \"value\": {{CREDIT_AMOUNT}},\n    \"currency\": \"{{CURRENCY}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "DEBIT Transaction (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Transaction succeeded', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.transaction.status).to.eql('SUCCEEDED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{ACCOUNT_ID}}\",\n  \"type\": \"DEBIT\",\n  \"amount\": {\n    \"value\": {{DEBIT_AMOUNT}},\n    \"currency\": \"{{CURRENCY}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "DEBIT Insufficient Balance (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Error is INSUFFICIENT_BALANCE', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('INSUFFICIENT_BALANCE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{ACCOUNT_ID}}\",\n  \"type\": \"DEBIT\",\n  \"amount\": {\n    \"value\": {{INSUFFICIENT_DEBIT_AMOUNT}},\n    \"currency\": \"{{CURRENCY}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "Account Not Found (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Error is ACCOUNT_NOT_FOUND', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('ACCOUNT_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{NON_EXISTENT_ACCOUNT_ID}}\",\n  \"type\": \"CREDIT\",\n  \"amount\": {\n    \"value\": {{CREDIT_AMOUNT}},\n    \"currency\": \"{{CURRENCY}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "No Token (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{ACCOUNT_ID}}\",\n  \"type\": \"CREDIT\",\n  \"amount\": {\n    \"value\": {{CREDIT_AMOUNT}},\n    \"currency\": \"{{CURRENCY}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health is UP', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/actuator/health",
              "host": ["{{BASE_URL}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ],
