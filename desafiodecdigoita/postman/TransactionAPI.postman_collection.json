{
  "info": {
    "name": "Transaction API",
    "_postman_id": "transaction-api-collection",
    "description": "API de Autorização de Transações Financeiras - ITAÚ Challenge",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Generate Token (Valid Credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"transaction-api-client\",\n  \"client_secret\": \"super-secret-key-123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/token",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        },
        {
          "name": "Generate Token (Invalid Credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"wrong\",\n  \"client_secret\": \"wrong\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/token",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "CREDIT Transaction (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"5b19c8b6-0cc4-4c72-a989-0c2ee15fa975\",\n  \"type\": \"CREDIT\",\n  \"amount\": {\n    \"value\": 100.00,\n    \"currency\": \"BRL\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "DEBIT Transaction (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"5b19c8b6-0cc4-4c72-a989-0c2ee15fa975\",\n  \"type\": \"DEBIT\",\n  \"amount\": {\n    \"value\": 50.00,\n    \"currency\": \"BRL\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "DEBIT Insufficient Balance (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"5b19c8b6-0cc4-4c72-a989-0c2ee15fa975\",\n  \"type\": \"DEBIT\",\n  \"amount\": {\n    \"value\": 99999.00,\n    \"currency\": \"BRL\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "Account Not Found (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"non-existent-account-id\",\n  \"type\": \"CREDIT\",\n  \"amount\": {\n    \"value\": 100.00,\n    \"currency\": \"BRL\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        },
        {
          "name": "No Token (403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"5b19c8b6-0cc4-4c72-a989-0c2ee15fa975\",\n  \"type\": \"CREDIT\",\n  \"amount\": {\n    \"value\": 100.00,\n    \"currency\": \"BRL\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/transactions/{{TRANSACTION_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "transactions", "{{TRANSACTION_ID}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/actuator/health",
              "host": ["{{BASE_URL}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8080"
    },
    {
      "key": "TOKEN",
      "value": ""
    },
    {
      "key": "ACCOUNT_ID",
      "value": "5b19c8b6-0cc4-4c72-a989-0c2ee15fa975"
    },
    {
      "key": "TRANSACTION_ID",
      "value": "{{$guid}}"
    }
  ]
}