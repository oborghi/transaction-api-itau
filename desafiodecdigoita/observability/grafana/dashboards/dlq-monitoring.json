{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "DLQ Messages Reprocessed (Total)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }
      },
      "targets": [
        {
          "expr": "sum(dlq_messages_reprocessed_total)",
          "legendFormat": "Total Reprocessed"
        }
      ]
    },
    {
      "title": "DLQ Reprocess Success Rate (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 90 }] }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(dlq_messages_reprocessed_total{status=\"success\"}[5m])) / sum(rate(dlq_messages_reprocessed_total[5m])) * 100",
          "legendFormat": "Success Rate"
        }
      ]
    },
    {
      "title": "DLQ Messages Reprocessed/sec",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      },
      "targets": [
        {
          "expr": "sum(rate(dlq_messages_reprocessed_total[5m]))",
          "legendFormat": "Rate"
        }
      ]
    },
    {
      "title": "DLQ Reprocess Failed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(dlq_messages_reprocessed_total{status=\"failed\"}[5m]))",
          "legendFormat": "Failed/sec"
        }
      ]
    },
    {
      "title": "DLQ Reprocessing Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(dlq_messages_reprocessed_total{status=\"success\"}[5m])",
          "legendFormat": "Success"
        },
        {
          "expr": "rate(dlq_messages_reprocessed_total{status=\"failed\"}[5m])",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "title": "SQS Messages Consumed vs Failed",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "rate(sqs_messages_consumed_total[5m])",
          "legendFormat": "Consumed/sec"
        },
        {
          "expr": "rate(sqs_messages_failed_total[5m])",
          "legendFormat": "Failed/sec"
        }
      ]
    },
    {
      "title": "Circuit Breaker State (DLQ)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "CLOSED" }, "1": { "text": "OPEN" }, "2": { "text": "HALF-OPEN" } }, "type": "value" }
          ]
        }
      },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=~\".*dlq.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["transaction-api", "dlq", "sqs"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Transaction API - DLQ Monitoring",
  "uid": "dlq-monitoring",
  "version": 1
}