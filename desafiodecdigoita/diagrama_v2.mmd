flowchart LR
    subgraph AWS["AWS Cloud - sa-east-1"]
        subgraph VPC["VPC 10.0.0.0/16"]
            Client["Cliente<br/>Mobile/Web"]
            ALB["ALB<br/>HTTP:80"]
            EKS["Amazon EKS<br/>K8s+Karpenter+HPA"]
            Atlas["MongoDB Atlas<br/>M10 Cluster 3AZs"]

            Client --> ALB
            ALB --> EKS
            EKS --> Atlas

            subgraph Pods["Pods EKS"]
                App["Pod App<br/>x2-10"]
                API["Pod API<br/>x2-10"]
            end

            SQS["SQS + DLQ<br/>Filas"]
            Secrets["Secrets Manager<br/>Credenciais"]
            CW["CloudWatch<br/>Logs & Metrics"]
            ECR["ECR<br/>Registry"]
            S3["S3<br/>Logs"]
            XRay["X-Ray<br/>Tracing"]

            EKS -.- SQS
            EKS -.- Secrets
            EKS -.- CW
            EKS -.- ECR
            EKS -.- S3
            EKS -.- XRay
        end
    end

    subgraph Pipeline["CI/CD Pipeline"]
        direction LR
        GH["GitHub Push"] --> CB1["CodeBuild<br/>Test"]
        CB1 --> DB["Docker Build"]
        DB --> CD["CodeDeploy<br/>Blue/Green"]
        CD --> VF["Verify"]
        VF --> RB["Rollback<br/>Auto"]
    end

    style Client fill:#003366,color:#fff
